# Server Connection
HUB_URL=http://127.0.0.1:8000
NODE_ID=local-node-1
NODE_NAME=Primary Local Node
NODE_API_KEY=local_secret_key

# MT5 Cloner Configuration
MASTER_MT5_DIR=E:\MT5 instances\Master MT5
CLIENTS_DIR=CLIENTS

# Hardware Capacity Limits
MAX_TERMINALS=25
POLL_INTERVAL=8

# CPU & Latency Tuning
# FAST_POLL_INTERVAL: local worker IPC check rate in seconds (default 0.08 = 80ms)
FAST_POLL_INTERVAL=0.08
# COMMAND_POLL_INTERVAL: hub fallback HTTP command poll in seconds (default 0.15 = 150ms)
COMMAND_POLL_INTERVAL=0.15
# TELEMETRY_INTERVAL: full telemetry broadcast interval in seconds (default 2.0s)
TELEMETRY_INTERVAL=2.0
